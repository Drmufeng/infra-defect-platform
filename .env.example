# docker-compose 与部署脚本可复用的环境变量示例
POSTGRES_DB=infra_defect_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=231223

API_HOST=0.0.0.0
API_PORT=2048
API_ROOT_PATH=
API_DOCS_ENABLED=true
API_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5180,http://127.0.0.1:5180

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=1234
AUTH_SECRET_KEY=infra-defect-platform-dev-secret

ADMIN_VITE_API_BASE_URL=/api
CLIENT_VITE_API_BASE_URL=/api
ADMIN_PORT=5500
CLIENT_PORT=5180
